PORT=3000
DATABASE_URL=./data/baito.db

# Gere com: openssl rand -hex 64
JWT_SECRET=troque_por_um_secret_longo_e_aleatorio
JWT_REFRESH_SECRET=troque_por_outro_secret_longo_e_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@baito.local
# Opção recomendada: derive a senha admin em runtime a partir deste secret.
# Veja a senha calculada com: npm run admin:password
ADMIN_PASSWORD_DERIVE_SECRET=troque_por_um_secret_longo_para_derivar_a_senha_admin

# Alternativas: senha direta para desenvolvimento ou hash bcrypt para produção.
# ADMIN_PASSWORD=troque_essa_senha_em_desenvolvimento
# ADMIN_PASSWORD_HASH=$2b$12$...
ADMIN_JWT_EXPIRES_IN=2h

BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
